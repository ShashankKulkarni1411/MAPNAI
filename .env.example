# ─────────────────────────────────────────────────────────────
#  MAPNAI — Environment Configuration
#  Copy this file to .env and fill in your credentials.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── News APIs ────────────────────────────────────────────────
NEWSAPI_KEY=your_newsapi_key
GNEWS_API_KEY=your_gnews_api_key
NEWSDATA_API_KEY=your_newsdata_api_key
GROQ_API_KEY=your_groq_api_key
# GROQ_MODEL=openai/gpt-oss-120b

# ── Agent 3 summarizer: auto | extractive | llm ──────────────
# auto = Groq when GROQ_API_KEY is set, otherwise offline TF-IDF extractive
SUMMARIZER_BACKEND=auto

# ── Agent 4 risk scorer: model | auto | groq | ollama ────────
# model = offline, no LLM: DistilRoBERTa event model -> TF-IDF -> keyword rules, plus formula factors.
# auto = Groq, falling back to a local Ollama model when Groq fails (429 daily limit, outage) or has no key.
# Setup: install Ollama, then  ollama pull qwen2.5:7b  and  ollama create mapnai-risk -f scripts/ollama/Modelfile.risk
RISK_BACKEND=model
# RISK_EVENT_MODEL_DIR=models/risk_event
# RISK_TFIDF_MODEL_PATH=models/risk/event_model.joblib
# OLLAMA_BASE_URL=http://localhost:11434/v1
# RISK_OLLAMA_MODEL=mapnai-risk
# RISK_GROQ_COOLDOWN_SECONDS=900          # after a Groq failure, go straight to Ollama for this long

# ── Agent 5 query graph (LangGraph; needs GROQ_API_KEY, else single-pass) ──
QUERY_GRAPH_ENABLED=true
# QUERY_GRAPH_MODEL=                      # all of Ask (graph + single-pass); blank = GROQ_MODEL. A different model keeps its own daily token limit
# QUERY_GRAPH_GRADER_MODEL=               # blank = QUERY_GRAPH_MODEL; a small model keeps grading cheap
# QUERY_GRAPH_MAX_REWRITES=2
# QUERY_GRAPH_MAX_REGENERATIONS=1
# QUERY_GRAPH_MAX_LLM_CALLS=10            # per question, single-pass fallback included
# QUERY_GRAPH_MIN_RELEVANT_DOCS=1
# QUERY_GRAPH_DEADLINE_SECONDS=12         # no rewrite/regeneration starts after this (app timeout is 20 s)
# QUERY_GRAPH_LLM_TIMEOUT_SECONDS=8
# QUERY_GRAPH_CREDIBILITY_WEIGHT=0.3
# QUERY_GRAPH_MIN_CREDIBILITY=0.2
# QUERY_GRAPH_NEO4J_COOLDOWN_SECONDS=300

# ── MongoDB ──────────────────────────────────────────────────
# Local:  mongodb://localhost:27017
# Atlas (team cluster; ask for the mapnai_app password, URL-encode special characters e.g. @ -> %40):
#   MONGO_URI=mongodb+srv://mapnai_app:<password>@mapnai-cluster-2.b59nhsg.mongodb.net/?retryWrites=true&w=majority&appName=mapnai-cluster-2
# Your public IP must be on the cluster's Network Access list in Atlas.
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=mapnai

# ── Neo4j ────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

# ── FAISS (local path for index persistence) ─────────────────
FAISS_INDEX_PATH=./data/faiss_index
FAISS_METADATA_PATH=./data/faiss_metadata.pkl

# ── Embedding Model ──────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Ingestion Settings ───────────────────────────────────────
INGESTION_INTERVAL_MINUTES=30
MAX_ARTICLES_PER_SOURCE=50
MIN_ARTICLE_LENGTH=100
REQUEST_TIMEOUT_SECONDS=15
# DEDUP_SEED_DAYS=7                       # fingerprints of the last N days seed the duplicate index
# BLUESKY_INGEST_ARTICLES=false           # raw Bluesky posts as articles (noisy; off)

# ── Continuous stream (stream_worker.py; continousexplanation.md) ──
# STREAM_TICK_SECONDS=15                  # how often the worker checks which sources are due
# STREAM_FLUSH_SECONDS=120                # micro-batch: flush every N seconds …
# STREAM_FLUSH_MAX=200                    # … or at this many buffered items
# STREAM_POLL_WORKERS=8                   # parallel feed downloads
# STREAM_MIN_INTERVAL_TOP_S=120           # adaptive polling bounds: top-stories feeds …
# STREAM_MIN_INTERVAL_S=300               # … other feeds …
# STREAM_MAX_INTERVAL_S=1200              # … and the slowest any feed is polled
# STREAM_API_INTERVAL_MINUTES=60          # NewsAPI / GNews / NewsData (quotas)
# STREAM_SCRAPER_INTERVAL_MINUTES=30
# STREAM_FAISS_SAVE_SECONDS=600
# STREAM_RUN_AGENTS=true                  # Agents 1-2 on every flush, Agents 3-4 on the hottest pending
# STREAM_LLM_PER_FLUSH=20                 # Agents 3-4 articles per flush (0 = leave them to pipeline.py)
# RISK_SHARE_IN_CLUSTER=true              # reuse a cluster-mate's Agent 4 score instead of another LLM call
# STREAM_SOCIAL_ENABLED=false             # count Bluesky posts about hot stories (Jetstream)

# ── Hit news, breaking alerts, push (PERS_*) ──
# PERS_HOT_BREAKING_H=0.65
# PERS_HOT_TRENDING_H=0.45
# PERS_HOT_HALF_LIFE_H=6
# PERS_HOT_DOMAINS=["sports","entertainment_movies"]
# PERS_BREAKING_MIN_PI=0.2
# PERS_BREAKING_GLOBAL_MIN_H=0.75
# PERS_BREAKING_GLOBAL_MAX_PER_DAY=2
# PERS_TOP_HOT_WEIGHT=0.3                 # Big today = 0.7·materiality + 0.3·hotness
# PERS_ENABLE_PUSH=true                   # Expo pushes for delivered alerts
# PERS_PUSH_ACCESS_TOKEN=                 # only with Expo enhanced push security

# ── Language ─────────────────────────────────────────────────
PRIMARY_LANGUAGE=en

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=./logs/ingestion.log

# ── App accounts (mobile sign-up / sign-in) ──────────────────
# Long random string that signs login tokens, e.g. python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave empty only for local testing: tokens then stop working whenever the API restarts.
AUTH_SECRET=
# Verification / reset codes are emailed over SMTP. Without SMTP_HOST they are printed in the API log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
