# ─────────────────────────────────────────────────────────────
#  MAPNAI — Environment Configuration
#  Copy this file to .env and fill in your credentials.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── News APIs ────────────────────────────────────────────────
NEWSAPI_KEY=your_newsapi_key
GNEWS_API_KEY=your_gnews_api_key
NEWSDATA_API_KEY=your_newsdata_api_key
GROQ_API_KEY=your_groq_api_key

# ── Agent 3 summarizer: auto | extractive | llm ──────────────
# auto = Groq when GROQ_API_KEY is set, otherwise offline TF-IDF extractive
SUMMARIZER_BACKEND=auto

# ── Reddit API ───────────────────────────────────────────────
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=MAPNAI/1.0 (by /u/your_username)

# ── MongoDB ──────────────────────────────────────────────────
# Local:  mongodb://localhost:27017
# Atlas (team cluster; ask for the mapnai_app password, URL-encode special characters e.g. @ -> %40):
#   MONGO_URI=mongodb+srv://mapnai_app:<password>@mapnai-cluster-2.b59nhsg.mongodb.net/?retryWrites=true&w=majority&appName=mapnai-cluster-2
# Your public IP must be on the cluster's Network Access list in Atlas.
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=mapnai

# ── Neo4j ────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

# ── FAISS (local path for index persistence) ─────────────────
FAISS_INDEX_PATH=./data/faiss_index
FAISS_METADATA_PATH=./data/faiss_metadata.pkl

# ── Embedding Model ──────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Ingestion Settings ───────────────────────────────────────
INGESTION_INTERVAL_MINUTES=30
MAX_ARTICLES_PER_SOURCE=50
MIN_ARTICLE_LENGTH=100
REQUEST_TIMEOUT_SECONDS=15
MAX_RETRIES=3

# ── Language ─────────────────────────────────────────────────
PRIMARY_LANGUAGE=en

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=./logs/ingestion.log

# ── App accounts (mobile sign-up / sign-in) ──────────────────
# Long random string that signs login tokens, e.g. python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave empty only for local testing: tokens then stop working whenever the API restarts.
AUTH_SECRET=
# Verification / reset codes are emailed over SMTP. Without SMTP_HOST they are printed in the API log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
